# Required. Signs and verifies login JWTs (HS256) -- there is no default, the
# app refuses to start without one. Must be at least 32 bytes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional. Minutes before an access token expires. Default: 480 (one workday).
# JWT_EXPIRE_MINUTES=480

# Optional. "development" (default) or "production". Only affects the
# database_url check below -- everything else behaves the same either way.
# APP_ENV=development

# Optional -- defaults to the local docker-compose Postgres (stock/stock).
# Set this for any real deployment; the app refuses to start if this is still
# a localhost URL while APP_ENV=production.
DATABASE_URL=postgresql+psycopg2://stock:stock@localhost:5432/stock

# Optional -- enables POST /api/screens/from-text. Leave blank to disable.
# Free key at https://console.groq.com/keys (Groq, OpenAI-compatible API).
GROQ_API_KEY=

# Optional. Groq model used for the above. Default: openai/gpt-oss-120b.
# NL_SCREEN_MODEL=openai/gpt-oss-120b

# Optional -- enables alerting (see app/services/alerting.py) for pipeline
# failures, suspiciously-low ingest counts, a stale/not-running pipeline, and
# DB-connection failures at startup. Leave unset to disable entirely (a
# no-op, no effect on local dev). Any Slack-compatible incoming webhook URL
# works -- Slack, Discord (Slack-compatible shim), Teams (compatible
# connector), or a custom endpoint accepting {"text": "..."}.
ALERT_WEBHOOK_URL=
