[Unit]
Description=Stock Tracker off-host database backup (app/jobs/backup_db.py)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# Edit these two paths for the deployment host, same convention as
# stock-daily-pipeline.service.
WorkingDirectory=/path/to/stock-application
ExecStart=/path/to/stock-application/.venv/bin/python -m app.jobs.backup_db
# EnvironmentFile=/path/to/stock-application/.env

# backup_db.run() raises (and main() alerts + exits 1) if BACKUP_S3_BUCKET
# isn't set -- this unit will fail loudly every day rather than silently
# doing nothing until BACKUP_S3_BUCKET/BACKUP_S3_ACCESS_KEY_ID/
# BACKUP_S3_SECRET_ACCESS_KEY (and BACKUP_S3_ENDPOINT_URL/REGION if not
# using real AWS S3) are set in the env file. See DEPLOYMENT.md "Known
# gaps" and README.md's Configuration table for what to set.
#   journalctl -u stock-backup
StandardOutput=journal
StandardError=journal
